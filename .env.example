APP_NAME=Solus Vires API
APP_ENV=development
CONTACT_SINK=console
MAX_CONTACT_MESSAGE_LENGTH=3000
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Used for local (non-Docker) development, e.g. `uvicorn backend.app.main:app --reload`.
# Points at the SAME Postgres the Docker stack uses (docker-compose.yml
# publishes it to 127.0.0.1:5433, not the default 5432, so it never collides
# with a Postgres you may already have installed locally). In Docker itself,
# DATABASE_URL is set automatically in docker-compose.yml from POSTGRES_PASSWORD.
DATABASE_URL=postgresql+psycopg://solusvires:replace-with-a-long-random-password@localhost:5433/solusvires
SESSION_COOKIE_SECURE=false
SESSION_TTL_DAYS=14

# Trusted-contact check-in system (all free-tier: Web Push has no per-message
# cost, and Brevo's email API is free up to 300/day). Generate real values
# with: python backend/scripts/generate_vapid_keys.py
PUBLIC_BASE_URL=http://127.0.0.1:8000
VAPID_PUBLIC_KEY=replace-with-generated-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-generated-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com
CHECKIN_TOKEN_SECRET=replace-with-a-long-random-secret
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=Solus Vires
CHECKIN_ALERT_CHECK_SECONDS=300
CHECKIN_ALERT_REPEAT_HOURS=6
