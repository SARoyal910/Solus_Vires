APP_NAME=Solus Vires API
APP_ENV=development
CONTACT_SINK=console
MAX_CONTACT_MESSAGE_LENGTH=3000
# Contact form (decision D3): each message is emailed here through Brevo and
# nothing is stored. Leave empty to keep the form off; the page then says a
# contact address is being set up. Needs BREVO_API_KEY too.
CONTACT_INBOX_EMAIL=
# The reply window the form promises ("within 7 days"). Keep it honest.
CONTACT_RESPONSE_DAYS=7
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Used for local (non-Docker) development, e.g. `uvicorn backend.app.main:app --reload`.
# Points at the SAME Postgres the Docker stack uses (docker-compose.yml
# publishes it to 127.0.0.1:5433, not the default 5432, so it never collides
# with a Postgres you may already have installed locally). In Docker itself,
# DATABASE_URL is set automatically in docker-compose.yml from POSTGRES_PASSWORD.
DATABASE_URL=postgresql+psycopg://solusvires:replace-with-a-long-random-password@localhost:5433/solusvires
SESSION_COOKIE_SECURE=false
SESSION_TTL_DAYS=14

# Trusted-contact check-in system (all free-tier: Web Push has no per-message
# cost, and Brevo's email API is free up to 300/day). Generate real values
# with: python backend/scripts/generate_vapid_keys.py
PUBLIC_BASE_URL=http://127.0.0.1:8000
VAPID_PUBLIC_KEY=replace-with-generated-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-generated-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com
CHECKIN_TOKEN_SECRET=replace-with-a-long-random-secret
# Key for recovery-code HMACs (python -c "import secrets; print(secrets.token_urlsafe(32))").
# Set it once and never change it: codes issued under the old value stop working.
RECOVERY_CODE_PEPPER=replace-with-a-long-random-secret
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=Solus Vires
CHECKIN_ALERT_CHECK_SECONDS=300
CHECKIN_ALERT_REPEAT_HOURS=6
# Off here so a local uvicorn sharing the Docker database doesn't run a second
# alert loop. Defaults to on when APP_ENV=production (the Docker api). Either
# way only one process at a time can run an alert pass (Postgres advisory lock).
CHECKIN_ALERT_LOOP_ENABLED=false
# Optional heartbeat: fetched (GET) after every completed alert pass, so a
# monitor such as Healthchecks.io can page someone when the loop stalls.
# Empty = off. A failed ping is logged and never affects alerts.
HEALTHCHECK_PING_URL=

# Only set true when the app sits behind the project's nginx, which overwrites
# X-Real-IP with the real visitor address. docker-compose.yml sets it.
TRUST_PROXY_HEADERS=false

# Operator-only notices. When one address is refused by the rate limits
# ABUSE_ALERT_THRESHOLD times in an hour, this address gets one email (never
# the IP itself; at most 5 a day). Empty = off.
OPERATOR_ALERT_EMAIL=
ABUSE_ALERT_THRESHOLD=50

# New accounts are invite-only until legal/advocacy review (docs/PHASE2_PLAN.md D1).
# Comma-separated codes; share one per person. Leave empty to pause sign-ups.
BETA_SIGNUPS_ENABLED=false
BETA_INVITE_CODES=
