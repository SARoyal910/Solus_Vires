APP_NAME=Solus Vires API
APP_ENV=development
CONTACT_SINK=console
MAX_CONTACT_MESSAGE_LENGTH=3000
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Used for local (non-Docker) development against a locally running Postgres.
# In Docker, DATABASE_URL is set automatically in docker-compose.yml from POSTGRES_PASSWORD.
DATABASE_URL=postgresql+psycopg://solusvires:replace-with-a-long-random-password@localhost:5432/solusvires
SESSION_COOKIE_SECURE=false
SESSION_TTL_DAYS=14
